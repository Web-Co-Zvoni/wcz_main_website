# Copy to .env.local for local overrides — values are baked into the build, so nothing secret here.
# Live values are in .env.production.

# Address of the booking system (rezervacni-system). Without it the contact form has no calendar
# and offers sending without a time.
# VITE_REZERVACE_TENANT picks another business than "webcozvoni" (e.g. a local test one).
# Local: http://localhost:3000 (npm run dev in rezervacni-system)
VITE_REZERVACE_URL=
